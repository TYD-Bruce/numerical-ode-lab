# Copy to .env.local for local development (never commit .env.local).
# On Vercel, set variables in Project Settings → Environment Variables.

# Public demo / free testing mode (recommended for Vercel public deployment)
AI_TUTOR_MOCK=true

# Optional live AI mode — server-side only; do NOT use VITE_ prefix
# OPENAI_API_KEY=sk-...

# Optional: local API dev server port (default 3001)
# API_PORT=3001

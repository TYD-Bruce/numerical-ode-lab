{
  "name": "numerical-t-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server/dev.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "verify": "npm run test:run && npm run typecheck && npm run typecheck:api && npm run build",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vercel/node": "^3.2.0",
    "jsdom": "29.1.1",
    "tsx": "^4.19.0",
    "typescript": "~5.4.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "0.58.0",
    "chart.js": "^4.4.0",
    "mathlive": "0.110.0"
  }
}
